# Copy to .env.local for local dev, and set the same vars in the Vercel project.
# Both are optional — the app has safe fallbacks — but setting them unlocks
# correct share previews and a working contact form.

# Canonical production origin. Drives metadataBase, OG/Twitter images, sitemap,
# robots, JSON-LD, and canonical. Set to your final custom domain once attached.
# Fallback if unset: https://portfolio-uiux-smoky.vercel.app
NEXT_PUBLIC_SITE_URL=https://portfolio-uiux-smoky.vercel.app

# Formspree form ID (the part after /f/ in your form endpoint). When set, the
# contact form POSTs to Formspree with inline success/error states. When unset,
# the form falls back to composing a mailto: in the visitor's mail client.
# Create a free form at https://formspree.io and paste its ID here.
NEXT_PUBLIC_FORMSPREE_ID=
